{
  "channels": [
    {"platform": "kick", "name": "adinross", "programme": "Adin Ross clipping programme"},
    {"platform": "kick", "name": "sealstats", "programme": "Seal (Content Rewards)"},
    {"platform": "twitch", "name": "lacy", "programme": "Lacy (Reach pool)"},
    {"platform": "twitch", "name": "kaicenat", "programme": null}
  ],

  "require_category_contains": ["Grand Theft Auto"],
  "min_score_to_alert": 3,
  "impact": {"enabled": true, "chat_prompt_share": 0.45, "min_score": 4, "ai": true},

  "discord_webhook_url": "",
  "status_webhook_url": "",
  "summary_webhook_url": "",
  "videos_webhook_url": "",

  "twitch_client_id": "",
  "twitch_client_secret": "",

  "kick_pusher_key": "",
  "kick_pusher_cluster": "",

  "data_dir": "data",

  "discovery": {
    "enabled": false,
    "categories": ["Grand Theft Auto VI"],
    "languages": ["en"],
    "min_viewers": 3000,
    "max_channels": 40,
    "interval_s": 300,
    "drop_after_s": 1800,
    "exclude": [],
    "max_alerts_per_hour": 12
  },

  "lacy": {
    "enabled": false,
    "channel": "lacy",
    "allowed_categories": ["Grand Theft Auto V", "Grand Theft Auto VI"],
    "max_uploads_per_day": 3,
    "facecam": {"x": 0.0, "y": 0.0, "w": 0.25, "h": 0.30},
    "privacy": "public",
    "whisper_model": "base",
    "submissions_csv": "logs/lacy_submissions.csv"
  },

  "campaigns": {"laurenhamdenn": {"enabled": false}},
  "clips": {
    "enabled": true,
    "max_uploads_per_day": 3,
    "max_renders_per_day": 10,
    "streamers": {
      "adinross": {"name": "Adin Ross", "facecam": {"x": 0.0, "y": 0.0, "w": 0.25, "h": 0.30}},
      "sealstats": {"name": "Seal", "facecam": {"x": 0.0, "y": 0.0, "w": 0.25, "h": 0.30}}
    }
  },

  "tokyo_girl": {
    "enabled": true,
    "per_day": 4,
    "bpm": 120,
    "min_s": 15,
    "max_s": 30,
    "export_dir": "exports/tokyo_girl",
    "media_dir": "data/rockstar_media"
  },

  "instagram": {
    "max_per_day": 3,
    "share_to_feed": true,
    "refresh_every_days": 50,
    "posts_csv": "logs/instagram_posts.csv",
    "tiktok_dir": "exports/tiktok",
    "tiktok_keep_days": 14
  },

  "review": {
    "board": true,
    "expire_hours": 48,
    "youtube_max_per_day": 6,
    "windows": {"youtube": ["07:00-23:00"], "instagram": ["08:00-22:30"], "tiktok": ["07:00-23:30"]},
    "modes": {
      "lacy": {"auto": ["youtube", "instagram", "tiktok"]},
      "tokyo_girl": {"auto": ["tiktok"]}
    }
  },

  "videos": {
    "discord_max_mb": 10,
    "gcs_bucket": "",
    "gcs_key_file": "gcs-key.json",
    "link_days": 7,
    "keep_days": 8
  },

  "detector": {
    "window_s": 10,
    "warmup_s": 180,
    "min_rate": 1.0,
    "ratio": 2.5,
    "z": 3.0,
    "cooldown_s": 45,
    "pre_roll_s": 30,
    "post_roll_s": 15
  }
}
