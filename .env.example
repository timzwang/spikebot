# Copy to /opt/spikebot/.env on the server (install.sh does this for you) and fill in.
# Values here override config.json.

# Free keys from https://dev.twitch.tv/console. Lacy mode needs these (GTA category check + VOD).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Lacy mode (README: "Lacy mode"). true/false.
LACY_MODE=false
LACY_MAX_UPLOADS_PER_DAY=3
# (LACY_AUTO_UPLOAD is no longer used: every clip waits for your approval in Discord.)

# Tokyo Girl mode (README: "Tokyo Girl mode"): silent GTA 6 edits for TikTok/IG, made daily.
TOKYO_GIRL_MODE=true
TOKYO_GIRL_PER_DAY=2

# #ready-to-post: private Google Cloud Storage bucket for videos too big for Discord
# (README: "Finished videos on your phone"). Key file: /opt/spikebot/gcs-key.json. Empty = no upload.
VIDEOS_GCS_BUCKET=

# YouTube upload: OAuth "Desktop app" client from Google Cloud Console (YouTube Data API v3).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Filled in for you by: venv/bin/python -m spikebot.youtube auth --env .env
YOUTUBE_REFRESH_TOKEN=

# Instagram Reels auto-posting for Lacy Shorts (README: "Instagram Reels").
# Meta app > Use cases > Instagram API > API setup with Unified login > Generate access tokens
# (EAA... token; `python -m spikebot.instagram check` shows the IG_USER_ID to use).
# Needs VIDEOS_GCS_BUCKET (Instagram downloads each video from a short-lived private link).
IG_USER_ID=
# EAA... tokens don't expire by default. Older IGAA... tokens are refreshed every 50 days.
IG_ACCESS_TOKEN=
IG_MAX_REELS_PER_DAY=3
INSTAGRAM_AUTO_POST=true

# Discord approval bot (README: "Approval in Discord"). Every clip waits for your Approve.
# Bot token from discord.com/developers > your app > Bot > Reset Token. Never share it.
DISCORD_BOT_TOKEN=
# Right-click > Copy ID (User Settings > Advanced > Developer Mode on).
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_TIKTOK_CHANNEL_ID=
DISCORD_INSPIRATION_CHANNEL_ID=
DISCORD_GUILD_ID=
# Your Discord user id (comma-separate several). Only these can press buttons / use commands.
DISCORD_APPROVER_IDS=
